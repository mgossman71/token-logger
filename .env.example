# =============================================================================
# Ollama Token Logger - environment configuration
# Copy to `.env` and adjust. Every value here is overridable.
# =============================================================================

# --- Identity / backend wiring -------------------------------------------
# Logical name recorded in every usage record and report.
BACKEND_NAME=rtx5090

# The Ollama server this logger proxies to (no trailing slash).
# The RTX 5090 primary server.
OLLAMA_BACKEND_URL=http://10.0.0.140:11434

# --- Network ----------------------------------------------------------------
# Host/port the logger listens on inside the container.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=11435

# --- Storage ---------------------------------------------------------------
# Directory for usage.jsonl (bind-mounted in docker-compose.yml).
DATA_DIR=/data

# Log rotation: rotate usage.jsonl when it exceeds this many bytes (0 = disable).
LOG_MAX_BYTES=104857600
# Number of rotated files to keep (usage.jsonl.1 .. usage.jsonl.N).
LOG_BACKUPS=5

# --- Timeouts (seconds) ----------------------------------------------------
# TCP connect timeout to the backend.
CONNECT_TIMEOUT=10
# Per-read timeout while the model is generating (keep high for long inference).
READ_TIMEOUT=1800
# Pool / overall safety timeout.
TOTAL_TIMEOUT=1800

# Concurrency ceiling for upstream connections (httpx limits).
MAX_CONNECTIONS=200
MAX_KEEPALIVE_CONNECTIONS=60

# Rolling tail buffer (bytes) used to extract usage stats from the final
# response line/object without buffering the whole body. 8 MiB covers a
# full max-context single (non-streaming) response and any NDJSON final line.
TAIL_BUFFER_BYTES=8388608

# --- Pricing ---------------------------------------------------------------
# Path to the OpenAI pricing config (bundled in the image).
PRICING_FILE=/app/pricing.json
